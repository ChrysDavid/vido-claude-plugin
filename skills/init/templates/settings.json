{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch --show-current)",
      "Bash(ls*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose exec web python manage.py check*)",
      "Bash(docker compose exec web python manage.py test*)",
      "Bash(flutter analyze*)",
      "Bash(flutter test*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm run types*)",
      "Bash(npx jest*)",
      "Bash(npx tsc --noEmit*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ]
  }
}
